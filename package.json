{
  "name": "emirates-auction-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "preview": "wrangler dev --port 3000",
    "deploy": "npm run build && wrangler deploy",
    "sync:v1-home": "node scripts/sync-v1-home.mjs",
    "sync:v1-plates": "node scripts/sync-v1-plate-preview.mjs",
    "sync:v1": "npm run sync:v1-home && npm run sync:v1-plates",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.99.0",
    "@walletconnect/modal": "2.7.0",
    "@walletconnect/modal-core": "2.7.0",
    "@walletconnect/universal-provider": "2.26.0",
    "buffer": "^6.0.3",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tronweb": "^6.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
