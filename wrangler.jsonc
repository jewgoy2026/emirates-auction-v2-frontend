{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "official",
  "account_id": "50597716b756a3ea78ea04335fb49633",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "API_BASE_URL": "https://api-emirates.203-161-52-90.nip.io",
    "UPSTREAM_ORIGIN": "https://official.emiratesauction.workers.dev"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
